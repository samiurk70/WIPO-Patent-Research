# Cached external inputs and computed intermediates — regenerated by the pipeline.
# The SHA-256 manifest under data/raw/ is committed.
/data/raw/*
!/data/raw/MANIFEST.sha256
/data/derived/*
!/data/derived/.gitkeep

# Python
__pycache__/
*.pyc
.venv
.venv/
venv/

# LaTeX build artefacts
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.abs
missfont.log

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.token
.git-credentials

# AI tool instructions and session artefacts — local only, never committed.
CLAUDE.md
AGENTS.md
.cursorrules
.cursorignore
.cursor/
.claude/
docs/CURSOR*.md
docs/WRITING_HANDOFF.md
docs/HANDOFF.md
docs/execution_plan.md
docs/docs_AGENT_TOOLING_SPEC.md
docs/PAPER_A_REVIEW*.md
**/.cursor/
**/.claude/
